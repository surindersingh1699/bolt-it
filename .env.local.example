# Copy to .env.local and fill in what you need.
#
# The app runs with ZERO of these set — every integration falls back to an
# in-memory or clearly-labeled simulated branch. Each key below unlocks one
# real backend. Nothing here is required to boot.

# ─── LLM: drafting, risk judge, verifier, reply synthesis ────────────────────
# The single most impactful key. Without it, every ticket falls back to an
# acknowledge-only plan — the agent cannot draft, classify, or verify.
# Any OpenAI-compatible endpoint works.
AI_GATEWAY_API_KEY=
AI_GATEWAY_URL=https://ai-gateway.vercel.sh/v1
AI_GATEWAY_MODEL=anthropic/claude-haiku-4-5
# Conversational Slack-thread replies. Defaults to AI_GATEWAY_MODEL.
AI_GATEWAY_CHAT_MODEL=
# Risk classifier for capabilities not on either policy allowlist.
# Unset → unlisted capabilities default to "high" (human approval required).
POLICY_JUDGE_MODEL=anthropic/claude-haiku-4-5

# ─── InsForge: Postgres persistence ─────────────────────────────────────────
# Unset → everything lives in the in-memory store (src/lib/db.ts) and is lost
# on restart. Apply migrations/ in order before first use.
NEXT_PUBLIC_INSFORGE_URL=
NEXT_PUBLIC_INSFORGE_ANON_KEY=
INSFORGE_API_KEY=

# ─── Local device agent ─────────────────────────────────────────────────────
# Shared bearer token between the app and scripts/local-agent.mjs. Both sides
# must match. Unset → /api/agent/* rejects every poll, so no job ever runs on
# a real machine. Generate: openssl rand -hex 32
LOCAL_AGENT_TOKEN=
# Set on the AGENT side only (not here) — where the agent finds this app.
# e.g. http://10.0.2.2:3000 (UTM) or http://192.168.217.1:3000 (VMware Fusion)
# IT_SUPPORT_APP_URL=
# LOCAL_AGENT_POLL_MS=2000
# LOCAL_AGENT_UPDATE_MS=60000
# LOCAL_AGENT_SPEAK=1

# ─── Slack ──────────────────────────────────────────────────────────────────
# Outbound (agent → Slack) works with just an installed workspace token.
# Inbound (Slack → ticket) also needs a public URL; see DEMO_SCENARIOS.md.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# ─── Sessions ───────────────────────────────────────────────────────────────
# HMAC key for the it_session cookie. Unset → a stable dev secret is used, so
# local login works with no setup. MUST be set in production.
SESSION_SECRET=

# ─── Vercel Sandbox: read-only log inspection ───────────────────────────────
# Unset → sandbox log reads return a canned corpus, labeled simulated.
VERCEL_SANDBOX_TOKEN=

# ─── Deployment ─────────────────────────────────────────────────────────────
# Public origin, used to build Slack OAuth redirect URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Guards /api/cron/cleanup-demos. Set this in production or the endpoint is open.
CRON_SECRET=

# ─── LangSmith tracing (optional) ───────────────────────────────────────────
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
